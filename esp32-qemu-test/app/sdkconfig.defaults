# ESP32 target
CONFIG_IDF_TARGET="esp32"

# Flash: 4 MB (required for QEMU)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Custom partition table with FAT storage partition
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# FatFs configuration — matches the default ESP-IDF settings
# that every ESP32 developer uses (widely copied pattern)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Disable Wi-Fi and BT to reduce binary size and build time
CONFIG_ESP_WIFI_ENABLED=n
CONFIG_BT_ENABLED=n

# Increase main task stack for diagnostic output
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Reduce log noise from boot components
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
